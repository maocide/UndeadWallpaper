<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UndeadWallpaper" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/light_green</item>
        <item name="colorSecondary">@color/zombie_green</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.UndeadWallpaper.BottomSheetDialog</item>
        <item name="popupMenuStyle">@style/Widget.UndeadWallpaper.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.UndeadWallpaper.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.UndeadWallpaper.PopupMenu</item>
    </style>

    <style name="Widget.UndeadWallpaper.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rim</item>
        <item name="android:overlapAnchor">true</item>
    </style>

    <style name="Theme.UndeadWallpaper" parent="Base.Theme.UndeadWallpaper" />

    <style name="CornerStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ThemeOverlay.UndeadWallpaper.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.UndeadWallpaper.BottomSheet</item>
    </style>

    <style name="Widget.UndeadWallpaper.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_sheet_rim</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.UndeadWallpaper.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.UndeadWallpaper.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="TextAppearance.UndeadWallpaper.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>