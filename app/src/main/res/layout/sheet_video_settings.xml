<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheet_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet_rim"
    android:clipToOutline="true"
    tools:context=".ui.VideoSettingsSheet">

    <org.maocide.undeadwallpaper.ui.GestureSafeScrollView
        android:id="@+id/settings_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/settings_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/preview_frame_container"
                android:layout_width="52dp"
                android:layout_height="116dp"
                android:layout_gravity="center_vertical"
                app:cardBackgroundColor="@android:color/black"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/thumbnail_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="matrix"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    tools:alpha="1" />

                <View
                    android:id="@+id/thumbnail_camera_hole"
                    android:layout_width="3.5dp"
                    android:layout_height="3.5dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="3.5dp"
                    android:background="@drawable/bg_camera_punch_hole"
                    android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/video_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="video.mp4" />

                <TextView
                    android:id="@+id/video_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/custom_settings_header"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/position_x_parallax_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/parallax_position_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textStyle="italic"
                    android:textColor="@color/light_green"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reset_advanced"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="0dp"
                    android:text="@string/reset"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconSize="16dp" />

            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/positioning_header"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"
                    />

                <TextView
                    android:id="@+id/scaling_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scaling_mode"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/scaling_mode_group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaling_mode_fit"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scaling_mode_fit" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaling_mode_fill"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scaling_mode_fill" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/scaling_mode_stretch"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scaling_mode_stretch" />
                    </com.google.android.material.chip.ChipGroup>

                    <ImageView
                        android:id="@+id/scaling_mode_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_fit_screen"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/zoom_label"
                    android:text="@string/zoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/zoom_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0.5"
                        android:valueTo="2.0"
                        android:value="1.0"
                        android:stepSize="0.05"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/zoom_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_zoom_in"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/position_x_label"
                    android:text="@string/horizontal_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/position_x_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="-2"
                        android:valueTo="2"
                        android:value="0.0"
                        android:stepSize="0.025"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/position_x_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_swap_horiz"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/position_y_label"
                    android:text="@string/vertical_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/position_y_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="-2"
                        android:valueTo="2"
                        android:value="0.0"
                        android:stepSize="0.025"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/position_y_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_swap_vert"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rotation_label"
                    android:text="@string/rotation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/rotation_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0.0"
                        android:valueTo="360.0"
                        android:value="0.0"
                        android:stepSize="1.0"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/rotation_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_rotate_right"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mirror_label"
                    android:text="@string/mirror_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/mirror_group"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:chipSpacingHorizontal="8dp"
                        app:singleSelection="false"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_flip_horizontal"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flip_horizontal" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_flip_vertical"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flip_vertical" />
                    </com.google.android.material.chip.ChipGroup>

                    <ImageView
                        android:id="@+id/mirror_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_flip"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/general_header"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/volume_label"
                    android:text="@string/volume_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/volume_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0.0"
                        android:valueTo="1.0"
                        android:value="0.0"
                        android:stepSize="0.1"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/volume_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_volume_up"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/speed_label"
                    android:text="@string/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/speed_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0.2"
                        android:valueTo="2.0"
                        android:value="1.0"
                        android:stepSize="0.1"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/speed_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_speed"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/brightness_label"
                    android:text="@string/brightness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brightness_slider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="0.0"
                        android:valueTo="2.0"
                        android:value="1.0"
                        android:stepSize="0.1"
                        app:tickVisible="false" app:trackStopIndicatorSize="0dp" />

                    <ImageView
                        android:id="@+id/brightness_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_light_mode"
                        android:contentDescription="@null"
                        android:alpha="0.5"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>
    </org.maocide.undeadwallpaper.ui.GestureSafeScrollView>

    <FrameLayout
        android:id="@+id/peek_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/peek_content_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/peek_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/black"
                app:cardCornerRadius="20dp"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorOutline"
                app:cardElevation="16dp">

                <ImageView
                    android:id="@+id/peek_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="matrix"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/peek_camera_hole"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_camera_punch_hole"
                    android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/peek_parallax_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_parallax_pill"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_swap_horiz"
                    app:tint="?android:attr/textColorSecondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/parallax_card_title"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="normal" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>